rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: public read, write allowed for website management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: public read, write allowed for website management
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Banners: public read, write allowed for website management
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Store Settings: public read, write allowed for website management
    match /storeSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: public create and read, write allowed for admin management
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Archived Orders: public read, write allowed for admin management
    match /archivedOrders/{archivedOrderId} {
      allow read: if true;
      allow write: if true;
    }

    // Isolated User Session Carts
    match /userCarts/{cartId} {
      allow read, write: if true;
    }
  }
}
